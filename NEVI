/// ───────── 1. EKRAN: GİRİŞ (HATA DÜZELTİLDİ: SCROLL EKLENDİ) ─────────
class MatchScreen extends StatelessWidget {
  const MatchScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final controller = TextEditingController();

    return Scaffold(
      // resizeToAvoidBottomInset: false, // Alternatif çözüm (Klavye üstüne binmesin diye)
      body: Column(
        children: [
          const FlightTimeBar(),
          Expanded(
            // SingleChildScrollView eklendi: Klavye açılınca taşmayı önler
            child: SingleChildScrollView(
              child: Padding(
                padding: const EdgeInsets.all(24),
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    const SizedBox(height: 40), // Üstten biraz boşluk
                    const Icon(Icons.smart_toy, size: 100, color: Colors.indigo),
                    const SizedBox(height: 24),
                    const Text(
                      'Merhaba ben Nevi',
                      style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
                    ),
                    const SizedBox(height: 8),
                    const Text('Eşleşme kodunu lütfen gir'),
                    const SizedBox(height: 32),
                    TextField(
                      controller: controller,
                      maxLength: 4,
                      keyboardType: TextInputType.number,
                      textAlign: TextAlign.center,
                      style: const TextStyle(fontSize: 26, letterSpacing: 8),
