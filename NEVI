}

/// ───────── 2. EKRAN: BAGAJ ─────────
class BagajScreen extends StatefulWidget {
  const BagajScreen({super.key});

  @override
  State<BagajScreen> createState() => _BagajScreenState();
}

class _BagajScreenState extends State<BagajScreen> {
  int seconds = 5;
  bool started = false;

  void startCountdown() async {
    setState(() => started = true);
    while (seconds > 0) {
      await Future.delayed(const Duration(seconds: 1));
      if (mounted) setState(() => seconds--);
    }
    if (mounted) {
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (_) => const HomeScreen()),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Column(
        children: [
          const FlightTimeBar(),
          Expanded(
            child: Center(
              child: Padding(
                padding: const EdgeInsets.all(24),
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    Container(
                      width: 140,
                      height: 140,
                      decoration: BoxDecoration(
                        color: Colors.purple.withOpacity(0.3),
                        shape: BoxShape.circle,
                      ),
                      child: const Icon(Icons.luggage, size: 80, color: Colors.purple),
                    ),
                    const SizedBox(height: 32),
                    if (!started) ...[
                      const Text(
                        'Lütfen bagajlarınızı mor alana yerleştiriniz.',
                        textAlign: TextAlign.center,
                        style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
                      ),
                      const SizedBox(height: 12),
                      const Text('Yerleşme tamamlandı mı?'),
                      const SizedBox(height: 24),
                      ElevatedButton(
                        onPressed: startCountdown,
                        child: const Text('EVET'),
                      ),
                      ElevatedButton(onPressed: () {}, child: const Text('HAYIR')),
                    ] else ...[
                      const Text(
                        'Sıkıştırma işlemi yapılıyor\nLütfen elleşmeyin',
                        textAlign: TextAlign.center,
                        style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
                      ),
                      const SizedBox(height: 16),
                      Text(
                        seconds.toString(),
                        style: const TextStyle(fontSize: 36, fontWeight: FontWeight.bold),
                      ),
                    ],
                  ],
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

